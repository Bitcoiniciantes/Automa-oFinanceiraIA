rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /usuarios/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /assistente/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
