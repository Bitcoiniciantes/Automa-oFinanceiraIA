VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_FIREBASE_APPCHECK_SITE_KEY=

# Base do Worker Cloudflare do FinAI (assistente + leitura de notas).
# Opcional: quando omitido, usa o endpoint público de produção.
VITE_FINAI_API_BASE_URL=https://bitcoiniciantes-ia.bitcoiniciantes.workers.dev

# Caminho base dos assets (Vite `base`).
# - Local / Firebase Hosting / Cloudflare: use a raiz (omitir ou "/").
# - GitHub Pages (repositório em subpath): use "/Automa-oFinanceiraIA/".
# O GitHub Actions define isso automaticamente no workflow deploy.yml.
VITE_BASE_PATH=/
